generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 安卓设备：以设备名（name）全局唯一标识，App 上报时按名自动创建
model Device {
  id         String    @id @default(cuid())
  name       String    @unique
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  messages   Message[]
  sendTasks  SendTask[]
}

// 下行发送任务：Web/URL 创建，App 轮询执行并回执
model SendTask {
  id        String    @id @default(cuid())
  deviceId  String
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  to        String
  body      String
  simSlot   Int?      // 1 | 2，null = 系统默认卡
  status    String    @default("pending") // pending | sent | failed
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([deviceId, status])
}

// 短信记录：unique(deviceId, address, smsDate) 用于 App 重传时幂等去重
model Message {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  address   String
  body      String
  type      String   @default("received") // received | sent
  smsDate   DateTime // 短信在手机上的收发时间
  createdAt DateTime @default(now())

  @@unique([deviceId, address, smsDate], name: "device_address_date")
  @@index([smsDate])
}

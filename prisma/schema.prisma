generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 安卓设备：以设备名（name）全局唯一标识，App 上报时按名自动创建
model Device {
  id          String    @id @default(cuid())
  name        String    @unique
  phoneNumber String?   // 本机号码（App 上报，取不到为空）
  lastSeenAt  DateTime?
  createdAt  DateTime  @default(now())
  messages   Message[]
}

// 短信记录：unique(deviceId, address, smsDate) 用于 App 重传时幂等去重
model Message {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  address   String
  body      String
  type      String   @default("received") // received | sent
  receiverNumber String? // 接收卡号码（App 按 sub_id 解析上报，取不到为空）
  smsDate   DateTime // 短信在手机上的收发时间
  createdAt DateTime @default(now())

  @@unique([deviceId, address, smsDate], name: "device_address_date")
  @@index([smsDate])
}
